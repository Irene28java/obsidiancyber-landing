# Development server. Keep local until production security review is complete.
OBSIDIAN_HOST=127.0.0.1
OBSIDIAN_PORT=8000

# Paid Exposure Brief pilot. Amount in EUR cents (7900 = 79.00 EUR).
# Copy this file to .env and fill with your own TEST keys first. Never upload .env.
OBSIDIAN_STRIPE_SECRET_KEY=
OBSIDIAN_PUBLIC_BASE_URL=
OBSIDIAN_REPORT_PRICE_CENTS=7900
OBSIDIAN_REPORT_RETENTION_DAYS=30
# Keep false until legal identity, terms, privacy and tax treatment are completed and reviewed.
OBSIDIAN_COMMERCIAL_TERMS_READY=false

# Optional reputation source. IPs will be sent to AbuseIPDB only after explicit end-user consent.
# Confirm current API plan, commercial service permission, and terms before selling these results.
OBSIDIAN_ABUSEIPDB_API_KEY=

# Optional local MMDB databases. Only use a licence that permits showing data in reports sold to third parties.
# For MaxMind, review the commercial/redistribution licence: the standard database licence may not permit customer-facing display.
OBSIDIAN_GEOIP_CITY_DB=
OBSIDIAN_GEOIP_COUNTRY_DB=
OBSIDIAN_GEOIP_ASN_DB=

# Disables free/direct analysis by default so customers cannot bypass Checkout.
# Set to true only on a developer's local test environment.
OBSIDIAN_ENABLE_FREE_ANALYSIS=false
